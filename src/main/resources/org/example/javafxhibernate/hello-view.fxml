<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.javafxhibernate.HelloController"
            prefWidth="800.0" prefHeight="500.0">
    <center>
        <TableView fx:id="table">
            <columns>
                <TableColumn fx:id="cId" prefWidth="60.0" text="Id" />
                <TableColumn fx:id="cNombre" prefWidth="300.0" text="Nombre" />
                <TableColumn fx:id="cCategoria" prefWidth="180.0" text="Categoria" />
                <TableColumn fx:id="cDisponible" prefWidth="120.0" text="Disponible" />
            </columns>
        </TableView>
    </center>
</BorderPane>
